[Unit]
Description=Apache Kafka (KRaft) broker {{ item.id }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kafka
Group=kafka
ExecStart=/opt/kafka/bin/kafka-server-start.sh /opt/kafka/config/kraft/server-{{ item.id }}.properties
TimeoutStopSec=180
KillSignal=SIGTERM
Restart=on-failure
RestartSec=10
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
